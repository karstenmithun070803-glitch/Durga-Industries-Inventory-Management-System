# Test database credentials — copy to .env.test and fill in your test DB values.
# .env.test is gitignored. NEVER use production DB credentials here.
#
# Use a SEPARATE Supabase project (or local Postgres) for tests.
# Apply the schema first: npm run db:test:push

DATABASE_URL=postgresql://postgres.[test-project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.[test-project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
